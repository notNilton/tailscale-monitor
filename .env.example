# Tailscale API Configuration
# Obtenha sua API key em: https://login.tailscale.com/admin/settings/keys

# API Key do Tailscale (necessária para listar dispositivos)
TAILSCALE_API_KEY="tskey-api-xxxxx"

# Seu tailnet (ex: example.com ou example.ts.net)
# Você pode encontrar isso em: https://login.tailscale.com/admin/settings/general
TAILSCALE_TAILNET="example.ts.net"
